<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.fitnessclub.controller.AntrenamentController"
      spacing="15">

    <HBox styleClass="header" alignment="CENTER_LEFT">
        <Label text="🗓 Gestionare Antrenamente" styleClass="header-title"/>
    </HBox>

    <VBox styleClass="card" spacing="10">
        <Label text="Adaugă / Editează Antrenament" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
        <GridPane hgap="10" vgap="8">
            <Label text="Denumire:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtDenumire" promptText="ex: Yoga Matinal" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200"/>

            <Label text="ID Antrenor:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtAntrenorId" promptText="ID antrenor" GridPane.columnIndex="3" GridPane.rowIndex="0" prefWidth="150"/>

            <Label text="Data:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpData" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Durata (min):" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
            <TextField fx:id="txtDurata" promptText="ex: 60" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

            <Label text="Capacitate:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtCapacitate" promptText="ex: 15" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Adaugă" styleClass="btn-primary" onAction="#adaugaAntrenament"/>
            <Button text="Actualizează" styleClass="btn-warning" onAction="#actualizeazaAntrenament"/>
            <Button text="Șterge" styleClass="btn-danger" onAction="#stergeAntrenament"/>
            <Button text="Golește" styleClass="btn-success" onAction="#golesteCampuri"/>
        </HBox>
        <Label fx:id="lblMesaj" styleClass="label-error"/>
    </VBox>

    <HBox styleClass="card" spacing="10" alignment="CENTER_LEFT">
        <Label text="Caută:"/>
        <TextField fx:id="txtCautare" promptText="Caută după denumire..." prefWidth="250" onKeyReleased="#cautaAntrenament"/>
        <Button text="Toate" styleClass="btn-primary" onAction="#incarcaAntrenamente"/>
    </HBox>

    <VBox styleClass="card" VBox.vgrow="ALWAYS">
        <TableView fx:id="tabelAntrenamente" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                <TableColumn fx:id="colDenumire" text="Denumire" prefWidth="160"/>
                <TableColumn fx:id="colAntrenor" text="Antrenor" prefWidth="150"/>
                <TableColumn fx:id="colData" text="Data" prefWidth="130"/>
                <TableColumn fx:id="colDurata" text="Durata" prefWidth="80"/>
                <TableColumn fx:id="colCapacitate" text="Capacitate" prefWidth="90"/>
                <TableColumn fx:id="colLocuri" text="Locuri libere" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>

</VBox>